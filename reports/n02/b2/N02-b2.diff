+    if bad == "revision":
+        data += b" revision 2"
+    elif bad == "table":
+        assignments[1].ref.table_id = "unknown-table"
+    elif bad == "content":
+        assignments[1].content_sha256 = "0" * 64
+    else:
+        assignments[1].scope.element_code = "COT"
+    before = [a.model_dump_json() for a in assignments]
