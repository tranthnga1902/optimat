+    if width is None or not math.isfinite(width) or width <= 0:
+        return None
+    direction, fixed, lo, hi = axis
+    return (lo, fixed - width / 2, hi, fixed + width / 2) if direction == "H" else (fixed - width / 2, lo, fixed + width / 2, hi)
