+@pytest.mark.parametrize("gate", ["opening", "column", "height", "unknown_openings", "unknown_columns"])
+def test_n03_review2_wide_tie_formwork_warning_survives_every_masonry_gate(cat, gate):
+    from optimat.rough.models import WorkItem
+    from optimat.rough.boq import boq_workbook
+    members = [_tie(b_mm=300)]
+    groups = normalize_ties(members, plan_context=True)
+    opening = ReviewOpening(id="O1", wall="W1", w=1000, h=2000)
+    args = dict(wall_height_mm=3000, openings=[], column_len_in_walls={})
+    if gate == "opening": args["openings"] = [opening]
+    elif gate == "column": args["column_len_in_walls"] = {"W1": 220}
+    elif gate == "height": args["wall_height_mm"] = None
+    elif gate == "unknown_openings": args["openings"] = None
+    else: args["column_len_in_walls"] = None
+    xay = WorkItem(code="XAY", name="xây", unit="m³", quantity=6.6, plan="T1", element="tường 220 bao che")
+    deduct_ties([xay], "T1", [WALL], {}, members, cat, tie_groups=groups, **args)
+    works, _ = linear_works("T1", members, tie_groups=groups)
+    bt, cp = works
+    assert bt.quantity == pytest.approx(0.18) and bt.status == "C" and not bt.missing
+    assert cp.quantity is None and cp.status == "D"
+    assert any("đáy không được tường đỡ đầy" in m for m in cp.missing)
+    assert xay.quantity is None and xay.status == "D"
