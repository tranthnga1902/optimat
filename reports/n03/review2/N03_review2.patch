+    res = compute_rough(req, cat)
+    cp = next(w for w in res.works if w.formwork_of == "GIANG_TUONG")
+    assert cp.quantity is None and cp.status == "D" and any("đáy không được tường đỡ đầy" in m for m in cp.missing)
