+/* Đo phần còn lại sau menu: hai cột cần ít nhất 480px cho CAD và 470px cho danh sách. */
+@container takeoff (max-width: 950px) {
+  .main { grid-template-columns: minmax(0, 1fr); grid-auto-rows: max-content; align-content: start; overflow-y: auto; }
+  .board {
+    display: grid;
+    grid-template: "tools" auto "drawing" clamp(260px, 46dvh, 520px) "help" auto / minmax(0, 1fr);
+    touch-action: auto;
+  }
+  /* Cả SVG chính và lớp xem nét trong lúc đọc dùng chung một vùng. */
+  .board > svg, .board > div:has(> svg), .board > .scale { grid-area: drawing; }
+  .board svg { touch-action: none; }
+  .toolbar { grid-area: tools; position: static; padding: 8px; background: var(--sunk); }
+  .seg button, .chipset label { white-space: nowrap; }
+  .chipset, .toolbar .field { flex-wrap: wrap; max-width: 100%; }
+  .hint, .hint:has(button) { grid-area: help; position: static; max-width: none; border-radius: 0; overflow-wrap: anywhere; }
   .aside { border-left: 0; border-top: 1px solid var(--rule); }
