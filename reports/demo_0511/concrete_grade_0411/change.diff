+@pytest.mark.parametrize("grade", ["M250/M300", "M250.5", "M250,5", "M250 chống thấm W8", "B250"])
+@pytest.mark.parametrize("supply", ["ready_mix", "site_mix"])
+@pytest.mark.parametrize("unclear_code", ["COT", "BE_TONG_LOT"])
+def test_concrete_unclear_grade_stays_separate(cat, grade, supply, unclear_code):
+    structural = unclear_code == "COT"
+    clear_code = "BE_TONG_LOT" if structural else "COT"
+    params = ProjectParams(concrete_supply=supply, concrete_grade=grade if structural else "M250",
+                           lean_concrete_grade="M250" if structural else grade)
+    bill = materials_for_works([work(clear_code, 2), work(unclear_code, 3)], params, cat)
+    pending, = [m for m in bill.materials if m.material_id is None]
+    assert grade in pending.name and any(grade in reason for reason in pending.missing)
+    assert pending.unit == "m³" and pending.quantity == 3 and not pending.complete and pending.status == "D"
+    assert [u.work for u in pending.uses] == [unclear_code] and pending.best_price is None and pending.est_cost is None
+    mix, = [i for i in bill.intermediates if i.grade == grade]
+    assert mix.material_id is None and mix.quantity == 3
+    known = [m for m in bill.materials if m.material_id is not None]
+    assert all([u.work for u in m.uses] == [clear_code] for m in known)
+    if supply == "ready_mix":
+        assert [m.material_id for m in known] == ["BT03"] and known[0].quantity == 2
+    else:
+        assert {m.material_id for m in known} == {"XM02", "CA01", "DA01"}
+        assert line(bill, "XM02").quantity == pytest.approx(2 * 0.31775, abs=1e-3)
+
+
+@pytest.mark.parametrize("grade", ["M250", "250", " m 250 ", "mác 250", "Bê tông thương phẩm mác M250"])
+def test_ready_mix_single_grade_forms(cat, grade):
+    assert ready_mix_material(cat, grade) == "BT03"
+
+
+@pytest.mark.parametrize("label", ["M250.5", "M250,5", "M250/M300"])
+def test_ready_mix_catalog_noninteger_or_combined_grade(cat, label):
+    materials = cat.materials.copy()
+    materials.loc[materials.material_id == "BT03", "name"] = f"Bê tông thương phẩm {label} (≈B20)"
+    assert ready_mix_material(replace(cat, materials=materials), "M250") is None
+
