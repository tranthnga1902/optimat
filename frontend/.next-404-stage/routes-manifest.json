{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "http://127.0.0.1:8000/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/docs",
        "destination": "http://127.0.0.1:8000/docs",
        "regex": "^/docs(?:/)?$"
      },
      {
        "source": "/openapi.json",
        "destination": "http://127.0.0.1:8000/openapi.json",
        "regex": "^/openapi\\.json(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [],
