# Chép thành .env (không đưa lên Git) rồi sửa mật khẩu. Ứng dụng tự đọc khi khởi động.
DATABASE_URL=postgresql+psycopg://optimat:MAT_KHAU@localhost:5432/optimat
# OPTIMAT_TEST_DATABASE_URL=postgresql+psycopg://optimat:MAT_KHAU@localhost:5432/optimat_test
# Khóa ký phiên đăng nhập (chuỗi ngẫu nhiên dài); để trống thì mỗi lần khởi động API sinh khóa mới, mọi người phải đăng nhập lại
# OPTIMAT_SECRET_KEY=
# OPENAI_API_KEY=
